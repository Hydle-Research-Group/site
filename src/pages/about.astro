---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About">
    <div class="max-w-3xl mx-auto">
        <header class="mb-12 text-center" transition:animate="fade">
            <h1 class="text-5xl mb-4">About</h1>
            <p class="text-xl text-muted-foreground">Mission Statement</p>
        </header>

        <div
            class="prose prose-lg dark:prose-invert max-w-none"
            transition:animate="fade"
        >
            <p>
                Hydle Research Group (HRG) is an independent organization
                dedicated to advancing research and general and electrical
                engineering. Our projects showcase analysis and process
                refinement to the creation of embedded systems, applications of
                mathematics, and the use of electromagnetic physics.
            </p>
            Being an established educate, or having a PhD isn't explicitly required
            to do research. It turns out you just need commitment and dedication,
            and our organization proves that.
        </div>
    </div>
</BaseLayout>
