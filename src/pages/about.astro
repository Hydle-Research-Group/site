---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About">
    <div class="max-w-3xl mx-auto">
        <header class="mb-12 text-center" transition:animate="fade">
            <h1 class="text-5xl mb-4">About</h1>
            <p class="text-xl text-muted-foreground">Learn more about us</p>
        </header>

        <div
            class="prose prose-lg dark:prose-invert max-w-none"
            transition:animate="fade"
        >
            <p>
                Hydle Research Group (HRG) is an independent organization
                dedicated to advancing research and engineering across computer
                science, robotics, and aerospace. We aim to be contribute
                greatly to these fields, with research produced by individuals <i
                    >obsessed</i
                > with discovery.
                <br />
            </p>
            You don't have to be an established educate, or have a PhD just to do
            research, it turns out you just need commitment and dedication. With the
            ever-growing internet "summing" human knowledge, anyone can become an
            expert in almost anything, and contribute to amazing projects.
        </div>
    </div>
</BaseLayout>
